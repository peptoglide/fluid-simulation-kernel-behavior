#pragma kernel CSMain

RWTexture2D<float4> Result;

int Width;
int Height;
float Scale;

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint x = id.x;
    uint y = id.y;

    if (x >= Width || y >= Height)
        return;

    // Convert pixel coordinates to function coordinates.
    float fx = ((float)x / Width - 0.5) * Scale;
    float fy = ((float)y / Height - 0.5) * Scale;

    float value = sin(fx) * cos(fy);

    // [-1, 1] -> [0, 1]
    float brightness = value * 0.5 + 0.5;

    Result[int2(x, y)] = float4(
        brightness,
        brightness,
        brightness,
        1.0
    );
}